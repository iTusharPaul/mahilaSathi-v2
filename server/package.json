{
  "name": "@mahilasathi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/cli/migrate.ts up",
    "db:status": "tsx src/cli/migrate.ts status",
    "check:providers": "tsx src/cli/checkProviders.ts",
    "demo:seed": "tsx src/cli/demo.ts seed",
    "demo:companion": "tsx src/cli/demo.ts companion",
    "db:backup": "tsx src/cli/migrate.ts backup",
    "demo:reset": "tsx src/cli/demo.ts reset",
    "coverage:assess": "tsx src/cli/demo.ts coverage"
  },
  "dependencies": {
    "@mahilasathi/shared": "*",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "~16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "h3-js": "^4.1.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "opening_hours": "^3.15.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.2",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2"
  }
}
