# ─── mahilaSathi server configuration ─────────────────────────────────────────
# Copy to `.env` and fill in. Every value here is read by the SERVER only.
# The browser bundle never reads environment variables; public runtime values
# are served by GET /api/config.

# Runtime
PORT=8080
NODE_ENV=development            # development | test | production
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace
# Comma-separated origins allowed to call the API cross-origin (dev Vite server).
CORS_ORIGINS=http://localhost:5173
# Production only: how many reverse proxies sit in front of the server (used for per-IP rate limits).
TRUST_PROXY=1
# Optional: a header your edge proxy sets with the visitor's IP (e.g. cf-connecting-ip behind Cloudflare/Render).
# Only set it if every request passes through that proxy, or clients could fake it.
CLIENT_IP_HEADER=

# Database (SQLite file; parent directory is created automatically)
DATABASE_PATH=./data/mahilasathi.db

# Secrets — REQUIRED in production, at least 32 random characters each.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ADMIN_TOKEN=

# Geoapify (geocoding, routing, places) — https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# Nexconn chat — https://docs.nexconn.ai/chatsdk-web
# The secret is used only for server-side token issue and never sent to clients.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Data centre: sg (Singapore, default) or na (North America). NEXCONN_API_HOST overrides the host.
NEXCONN_AREA=sg
NEXCONN_API_HOST=
# Configure the pre-messaging webhook in the Nexconn console to POST to:
#   https://<your-domain>/api/webhooks/nexconn

# OTP delivery. `mock` is only allowed when DEMO_MODE=true or NODE_ENV != production.
OTP_PROVIDER=mock
OTP_PROVIDER_API_KEY=

# Push notifications (optional). `none` disables push; `webpush` uses the Web Push standard.
PUSH_PROVIDER=none
PUSH_PROVIDER_API_KEY=
# With PUSH_PROVIDER=webpush, set a VAPID key pair (generate: npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https URL).
VAPID_SUBJECT=

# SMS for SOS alerts to emergency contacts. `none` (default) sends no SMS and SOS screens say so.
# `mock` is a development adapter: it records the message locally and sends nothing (refused in production
# unless DEMO_MODE=true). No real SMS provider is integrated yet.
SMS_PROVIDER=none

# Demo mode seeds fictional NCR users and labels all synthetic data in the UI.
DEMO_MODE=true
# Public demo hosts with a disk that resets (e.g. Render free): create the demo accounts at every start.
# Only honoured when DEMO_MODE=true.
DEMO_AUTOSEED=false

COMMUNITY_MODERATION_ENABLED=true
